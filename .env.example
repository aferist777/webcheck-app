# Токен Telegram-бота от @BotFather.
# ВАЖНО: если токен где-то засветился — перевыпустите его (@BotFather -> /revoke).
BOT_TOKEN=

# Ваш числовой Telegram user id. Бот личный: отвечает только id из whitelist.
# Узнать id: напишите @userinfobot.
OWNER_ID=

# Необязательно: дополнительные доверенные id через запятую.
EXTRA_WHITELIST=

# Необязательно: путь к node, если он не в PATH.
# NODE_BIN=node

# Необязательно: сколько доменов проверять параллельно (по умолчанию 4).
# DOMAIN_CONCURRENCY=4
